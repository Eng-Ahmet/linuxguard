[Unit]
Description=LinuxGuard Security Agent
Documentation=https://github.com/linuxguard/linuxguard
After=network.target local-fs.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/linuxguard --config /etc/linuxguard/config.yaml
Restart=on-failure
RestartSec=5s

# Security Hardening Directives
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
RestrictNamespaces=true
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_SYS_ADMIN

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
